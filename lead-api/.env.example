# Copy to .env.local for local testing with `vercel dev` (never commit that file).
# NONE of these have real values here. Nothing in this repo contains a real
# API key, password, or credential -- see README.md "Security" section for
# how this was verified.

# --- Email provider (Resend: https://resend.com) ---
RESEND_API_KEY=
# Must be a verified sending address/domain in your Resend account.
LEAD_NOTIFY_FROM_EMAIL=

# --- Northern Forge Windows, Blinds & Doors ---
NORTHERN_FORGE_NOTIFY_EMAIL=
NORTHERN_FORGE_ARCHIVE_EMAIL=
# The deployed site origin, e.g. https://northernforge.example.com
# Leave unset during testing (falls back to "*"); set once the real site
# has a real domain, to stop other origins from posting to this endpoint.
NORTHERN_FORGE_ALLOWED_ORIGIN=

# --- DEF Property Maintenance & Security ---
DEF_NOTIFY_EMAIL=
DEF_ARCHIVE_EMAIL=
DEF_ALLOWED_ORIGIN=

# --- Lindsay Blinds ---
LINDSAY_NOTIFY_EMAIL=
LINDSAY_ARCHIVE_EMAIL=
LINDSAY_ALLOWED_ORIGIN=

# --- Optional: also forward every accepted lead to a webhook (e.g. a
# Zapier/Make step feeding a spreadsheet or real database). Leave unset to
# rely on the notification email itself as the record -- see README.md
# "Persistence". ---
LEAD_STORE_WEBHOOK_URL=
